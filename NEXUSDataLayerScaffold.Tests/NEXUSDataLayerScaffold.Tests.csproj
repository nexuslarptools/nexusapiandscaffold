<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Keep tests project present but inert to avoid NuGet requirements in CI-lite builds -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <None Include="**\*.cs" />
    <Compile Remove="Infrastructure\CustomWebApplicationFactory.cs" />
    <Compile Remove="Infrastructure\TestAuthHandler.cs" />
    <Compile Remove="AuthIntegrationTests.cs" />
    <None Remove="Dummy.cs" />
    <Compile Include="Dummy.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEXUSDataLayerScaffold.csproj" />
  </ItemGroup>

</Project>
